[Unit]
Description=Compress queued motion event videos for camka
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/cam

[Service]
Type=oneshot
WorkingDirectory=/etc/motion
ExecStart=/usr/bin/python3 /etc/motion/motion.py jobs camka
Nice=10
CPUQuota=100%
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=2h
